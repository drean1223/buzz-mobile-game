{
  "name": "hoshineko-jump",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "node tools/sim.ts",
    "assets": "node tools/gen-assets.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vite-plugin-singlefile": "2.3.4"
  }
}
